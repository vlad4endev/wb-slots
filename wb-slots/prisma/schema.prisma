generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String                @id @default(cuid())
  email                String                @unique
  phone                String?               @unique
  passwordHash         String                @map("password_hash")
  name                 String?
  timezone             String                @default("Europe/Moscow")
  role                 UserRole              @default(USER)
  isActive             Boolean               @default(true) @map("is_active")
  emailVerified        DateTime?             @map("email_verified")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  isProtected          Boolean               @default(false) @map("is_protected")
  auditLogs            AuditLog[]
  foundSlots           FoundSlot[]
  notificationChannels NotificationChannel[]
  runs                 Run[]
  supplySnapshots      SupplySnapshot[]
  tasks                Task[]
  settings             UserSettings[]
  tokens               UserToken[]
  warehousePrefs       WarehousePref[]
  wbSessions           WBSession[]
  bookingResults       BookingResult[]
  authSessions         AuthSession[]
  permissions          UserPermission[]
  securityEvents       SecurityEvent[]
  apiKeys              ApiKey[]

  @@map("users")
}

model UserToken {
  id             String        @id @default(cuid())
  userId         String        @map("user_id")
  category       TokenCategory
  tokenEncrypted String        @map("token_encrypted")
  isActive       Boolean       @default(true) @map("is_active")
  lastUsedAt     DateTime?     @map("last_used_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, category, isActive])
  @@map("user_tokens")
}

model WarehousePref {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  warehouseId       Int      @map("warehouse_id")
  warehouseName     String   @map("warehouse_name")
  enabled           Boolean  @default(true)
  boxAllowed        Boolean  @default(true) @map("box_allowed")
  monopalletAllowed Boolean  @default(true) @map("monopallet_allowed")
  supersafeAllowed  Boolean  @default(true) @map("supersafe_allowed")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, warehouseId])
  @@map("warehouse_prefs")
}

model Task {
  id               String     @id @default(cuid())
  taskNumber       Int        @unique @default(autoincrement()) @map("task_number")
  userId           String     @map("user_id")
  name             String
  description      String?
  enabled          Boolean    @default(true)
  status           TaskStatus @default(PENDING)
  scheduleCron     String?    @map("schedule_cron")
  autoBook         Boolean    @default(false) @map("auto_book")
  autoBookSupplyId String?    @map("auto_book_supply_id")
  preorderID       String?    @map("preorder_id")
  chosenSupplyId   String?    @map("chosen_supply_id")
  filters          Json
  retryPolicy      Json       @map("retry_policy")
  priority         Int        @default(0)
  successCount     Int        @default(0) @map("success_count")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")
  runs             Run[]
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([enabled, status])
  @@index([createdAt])
  @@map("tasks")
}

model Run {
  id                String      @id @default(cuid())
  taskId            String      @map("task_id")
  userId            String      @map("user_id")
  status            RunStatus
  startedAt         DateTime    @map("started_at")
  finishedAt        DateTime?   @map("finished_at")
  foundSlots        Int?        @default(0) @map("found_slots")
  summary           Json?
  createdAt         DateTime    @default(now()) @map("created_at")
  foundSlotsDetails FoundSlot[]
  logs              RunLog[]
  task              Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId, status])
  @@index([userId, status])
  @@index([startedAt])
  @@map("runs")
}

model FoundSlot {
  id            String   @id @default(cuid())
  runId         String   @map("run_id")
  userId        String   @map("user_id")
  warehouseId   Int      @map("warehouse_id")
  warehouseName String   @map("warehouse_name")
  date          String
  timeSlot      String   @map("time_slot")
  coefficient   Float
  available     Boolean  @default(true)
  boxTypes      Json     @map("box_types")
  supplyId      String?  @map("supply_id")
  isBooked      Boolean  @default(false) @map("is_booked")
  bookingId     String?  @map("booking_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  run           Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, runId])
  @@index([warehouseId, date])
  @@index([isBooked, warehouseId, date, timeSlot])
  // Защита от дублирующих бронирований: один пользователь не может забронировать один и тот же слот дважды
  @@unique([userId, warehouseId, date, timeSlot, isBooked], name: "unique_active_booking")
  @@map("found_slots")
}

model RunLog {
  id      String   @id @default(cuid())
  runId   String   @map("run_id")
  level   LogLevel
  message String
  meta    Json?
  ts      DateTime @default(now())
  run     Run      @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@map("run_logs")
}

model SupplySnapshot {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  preorderId  String?   @map("preorder_id")
  supplyId    String?   @map("supply_id")
  warehouseId Int       @map("warehouse_id")
  boxTypeId   Int       @map("box_type_id")
  statusName  String    @map("status_name")
  supplyDate  DateTime? @map("supply_date")
  factDate    DateTime? @map("fact_date")
  updatedDate DateTime? @map("updated_date")
  raw         Json
  ts          DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("supply_snapshots")
}

model NotificationChannel {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  type      NotificationType
  config    Json
  enabled   Boolean          @default(true)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_channels")
}

model AuditLog {
  id     String   @id @default(cuid())
  userId String   @map("user_id")
  action String
  target String
  meta   Json?
  ts     DateTime @default(now())
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("audit_logs")
}

model WBSession {
  id                    String    @id @default(cuid())
  userId                String    @unique @map("user_id")
  sessionData           String    @db.Text @map("session_data") // Зашифрованные данные
  isActive              Boolean   @default(true) @map("is_active")
  
  // Метаданные
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  lastValidated         DateTime  @default(now()) @map("last_validated")
  expiresAt             DateTime? @map("expires_at") // Срок действия сессии (опционально для обратной совместимости)
  deactivatedAt         DateTime? @map("deactivated_at")
  deactivationReason    String?   @map("deactivation_reason")
  
  // Аудит
  ipAddress             String?   @map("ip_address")
  lastUsedAt            DateTime? @map("last_used_at")
  useCount              Int       @default(0) @map("use_count")
  
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@index([lastValidated])
  @@index([expiresAt])
  @@map("wb_sessions")
}

model BookingResult {
  id            String      @id @default(cuid())
  userId        String      @map("user_id")
  supplyId      String      @map("supply_id")
  warehouseId   Int         @map("warehouse_id")
  warehouseName String      @map("warehouse_name")
  bookingDate   String      @map("booking_date")
  timeSlot      String      @map("time_slot")
  boxTypes      String[]    @map("box_types")
  coefficient   Float?
  bookingId     String?     @map("booking_id")
  status        BookingStatus
  errorMessage  String?     @map("error_message")
  details       Json?
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("booking_results")
}

model UserSettings {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  category  String
  settings  Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@map("user_settings")
}

// Таблица для distributed locking при автобронировании
// Предотвращает одновременное выполнение нескольких процессов бронирования для одного пользователя
model BookingLock {
  id            String    @id @default(cuid())
  userId        String    @unique @map("user_id") // Только одна активная блокировка на пользователя
  lockKey       String    @map("lock_key") // Ключ блокировки (например, "booking:userId")
  lockedBy      String    @map("locked_by") // Идентификатор процесса (uuid)
  taskId        String?   @map("task_id") // ID задачи, которая держит блокировку
  supplyId      String?   @map("supply_id")
  warehouseId   Int?      @map("warehouse_id")
  
  // Метаданные блокировки
  acquiredAt    DateTime  @default(now()) @map("acquired_at")
  expiresAt     DateTime  @map("expires_at") // Автоматическое освобождение через TTL
  releasedAt    DateTime? @map("released_at")
  
  // Для отладки
  metadata      Json?
  
  @@index([userId, expiresAt])
  @@index([lockKey, expiresAt])
  @@map("booking_locks")
}

model ApiKey {
  id             String    @id @default(cuid())
  userId         String    @map("user_id")
  keyType        String    @map("key_type")
  keyName        String    @map("key_name")
  encryptedData  Json      @map("encrypted_data")
  description    String?
  isActive       Boolean   @default(true) @map("is_active")
  expiresAt      DateTime? @map("expires_at")
  metadata       Json      @default("{}")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, keyType, keyName])
  @@map("api_keys")
}

model Warehouse {
  id        Int      @id
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("warehouses")
}

model NotificationTemplate {
  id          String                   @id @default(cuid())
  name        String
  description String?
  type        NotificationTemplateType
  template    String
  variables   Json
  isActive    Boolean                  @default(true) @map("is_active")
  createdAt   DateTime                 @default(now()) @map("created_at")
  updatedAt   DateTime                 @updatedAt @map("updated_at")

  @@map("notification_templates")
}

model BotSettings {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  isEncrypted Boolean  @default(false) @map("is_encrypted")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("bot_settings")
}

enum UserRole {
  USER
  ADMIN
  DEVELOPER
}

enum TokenCategory {
  STATISTICS
  SUPPLIES
  MARKETPLACE
  CONTENT
  PROMOTION
  ANALYTICS
  FINANCE
}

enum RunStatus {
  QUEUED
  RUNNING
  SUCCESS
  FAILED
  PARTIAL
  CANCELLED
  COMPLETED
}

enum TaskStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  STOPPED
  BOOKING
  COMPLETED
}

enum BookingStatus {
  SUCCESS
  FAILED
  PENDING
  CANCELLED
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
}

enum NotificationType {
  EMAIL
  TELEGRAM
  WEBHOOK
}

enum NotificationTemplateType {
  SLOT_FOUND
  BOOKING_SUCCESS
  BOOKING_FAILED
  TASK_STARTED
  TASK_COMPLETED
  TASK_FAILED
  TASK_STOPPED
}

// ===== ADVANCED AUTH MODELS =====

model AuthSession {
  id                String    @id @default(cuid())
  userId            String    @map("user_id")
  sessionId         String    @unique @map("session_id")
  isActive          Boolean   @default(true) @map("is_active")
  expiresAt         DateTime  @map("expires_at")
  lastUsedAt        DateTime  @map("last_used_at")
  ipAddress         String?   @map("ip_address")
  userAgent         String?   @map("user_agent")
  deviceFingerprint String?   @map("device_fingerprint")
  location          String?   // JSON string with location data
  metadata          String?   // JSON string with additional metadata
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_sessions")
}

model UserPermission {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  permission String
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permission])
  @@map("user_permissions")
}

model SecurityEvent {
  id         String           @id @default(cuid())
  type       SecurityEventType
  userId     String           @map("user_id")
  sessionId  String?          @map("session_id")
  ipAddress  String?          @map("ip_address")
  userAgent  String?          @map("user_agent")
  details    String           // JSON string with event details
  timestamp  DateTime         @default(now())
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("security_events")
}

enum SecurityEventType {
  LOGIN
  LOGOUT
  SESSION_CREATED
  SESSION_EXPIRED
  SUSPICIOUS_ACTIVITY
  AUTH_FAILED
  CAPTCHA_DETECTED
  LOGIN_FAILED
}
