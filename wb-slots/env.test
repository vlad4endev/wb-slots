# ========================================
# WB Slots - Test Environment Variables
# ========================================

# Database Configuration
DATABASE_URL="postgresql://postgres:test_password_123@localhost:5433/wb_slots_test?schema=public"

# Redis Configuration
REDIS_URL="redis://localhost:6380"

# JWT Configuration
JWT_SECRET="test-jwt-secret-key-for-development-only"
JWT_EXPIRES_IN="1h"

# Encryption Configuration
ENCRYPTION_KEY="dGVzdC1lbmNyeXB0aW9uLWtleS0zMi1ieXRlcy1sb25n"

# Application Configuration
APP_BASE_URL="http://localhost:3001"
NODE_ENV="test"
PORT=3000

# Backend Configuration
BACKEND_PORT=3001

# Wildberries API Configuration (тестовые URL)
WB_API_BASE_URL="https://suppliers-api.wildberries.ru"
WB_STATISTICS_API_URL="https://statistics-api.wildberries.ru"
WB_MARKETPLACE_API_URL="https://marketplace-api.wildberries.ru"

# Telegram Bot Configuration (тестовые настройки)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_URL=""
TELEGRAM_WEBAPP_URL=""
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME="SearchLotWB_test_bot"

# Email Configuration (тестовые настройки)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Logging Configuration
LOG_LEVEL="debug"
LOG_FILE="logs/test-app.log"

# Rate Limiting (более мягкие лимиты для тестов)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=1000

# Session Configuration
SESSION_SECRET="test-session-secret-key"
SESSION_MAX_AGE=3600000

# CORS Configuration
CORS_ORIGIN="http://localhost:3001"

# Security Configuration (более мягкие настройки для тестов)
BCRYPT_ROUNDS=4
PASSWORD_MIN_LENGTH=6

# Worker Configuration
WORKER_CONCURRENCY=2
WORKER_DELAY_MS=500

# Monitoring Configuration
HEALTH_CHECK_INTERVAL=10000
METRICS_ENABLED=true

# Development Configuration
DEBUG_MODE=true
VERBOSE_LOGGING=true
HOT_RELOAD=true

# Puppeteer Configuration
PUPPETEER_SKIP_DOWNLOAD=true
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
