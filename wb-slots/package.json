{
  "name": "wb-slots",
  "version": "1.0.0",
  "description": "WB Slots - ��⥬� ��⮬�⨧�樨 ���᪠ � �஭�஢���� ᫮⮢ ���⠢�� �� Wildberries",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx src/lib/seed.ts",
    "db:seed-warehouses": "node scripts/seed-warehouses.js",
    "test": "vitest",
    "test:unit": "vitest run src/__tests__/unit",
    "test:unit:watch": "vitest watch src/__tests__/unit",
    "test:integration": "vitest run src/__tests__/integration",
    "test:integration:watch": "vitest watch src/__tests__/integration",
    "test:e2e": "playwright test",
    "test:e2e:parallel": "playwright test --workers=4",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:coverage": "vitest run --coverage",
    "test:coverage:watch": "vitest watch --coverage",
    "test:performance": "vitest run src/__tests__/performance",
    "test:load": "artillery run tests/load/load-test.yml",
    "test:security": "npm audit && snyk test",
    "test:all": "node scripts/test-automation.js all",
    "test:continuous": "node scripts/test-automation.js continuous",
    "test:setup": "node scripts/test-automation.js setup",
    "test:cleanup": "node scripts/test-automation.js cleanup",
    "test:file": "vitest run",
    "worker": "tsx src/workers/index.ts",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:restart": "docker-compose restart",
    "docker:clean": "docker-compose down -v && docker system prune -f",
    "app:init": "tsx src/scripts/initialize-app.ts",
    "app:migrate": "tsx src/scripts/migrate-to-unified.ts",
    "app:health": "curl -s http://localhost:3000/api/services?action=health | jq",
    "app:status": "curl -s http://localhost:3000/api/services?action=status | jq",
    "autobooking:test": "tsx src/scripts/test-autobooking.ts",
    "autobooking:init": "curl -X POST http://localhost:3000/api/autobooking -H 'Content-Type: application/json' -d '{\"action\": \"initialize\"}' | jq",
    "autobooking:status": "curl -s http://localhost:3000/api/autobooking?action=status | jq",
    "autobooking:health": "curl -s http://localhost:3000/api/autobooking?action=health | jq",
    "autobooking:queue": "curl -s http://localhost:3000/api/autobooking?action=queue | jq"
  },
