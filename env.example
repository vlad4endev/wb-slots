# ========================================
# WB Slots - Environment Configuration
# ========================================

# Database Configuration
DATABASE_URL="postgresql://postgres:password@localhost:5432/wb_slots?schema=public"

# Redis Configuration
REDIS_URL="redis://localhost:6379"

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-here-change-in-production"
JWT_EXPIRES_IN="7d"

# Encryption Configuration
ENCRYPTION_KEY="your-32-byte-base64-encryption-key-here"

# Application Configuration
APP_BASE_URL="http://localhost:3000"
NODE_ENV="development"
PORT=3000

# Backend Configuration
BACKEND_PORT=3001

# Wildberries API Configuration
WB_API_BASE_URL="https://suppliers-api.wildberries.ru"
WB_STATISTICS_API_URL="https://statistics-api.wildberries.ru"
WB_MARKETPLACE_API_URL="https://marketplace-api.wildberries.ru"

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_URL=""
TELEGRAM_WEBAPP_URL=""

# Email Configuration (Optional)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Logging Configuration
LOG_LEVEL="info"
LOG_FILE="logs/app.log"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Session Configuration
SESSION_SECRET="your-session-secret-key-here"
SESSION_MAX_AGE=86400000

# CORS Configuration
CORS_ORIGIN="http://localhost:3000"

# Security Configuration
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=8

# Worker Configuration
WORKER_CONCURRENCY=5
WORKER_DELAY_MS=1000

# Monitoring Configuration
HEALTH_CHECK_INTERVAL=30000
METRICS_ENABLED=true

# Development Configuration
DEBUG_MODE=true
VERBOSE_LOGGING=false
HOT_RELOAD=true

# Production Configuration (uncomment for production)
# NODE_ENV="production"
# DEBUG_MODE=false
# VERBOSE_LOGGING=false
# HOT_RELOAD=false

