@echo off
echo ========================================
echo    Тестирование синхронизации складов
echo ========================================
echo.

echo [1/3] Проверка структуры проекта...
if not exist "wb-slots\src\app\api\warehouses\sync\route.ts" (
    echo ❌ API endpoint для синхронизации складов не найден
    echo 💡 Проверьте структуру проекта
    pause
    exit /b 1
) else (
    echo ✅ API endpoint найден
)

if not exist "wb-slots\scripts\test-warehouse-sync.js" (
    echo ❌ Скрипт тестирования не найден
    echo 💡 Проверьте структуру проекта
    pause
    exit /b 1
) else (
    echo ✅ Скрипт тестирования найден
)

echo.
echo [2/3] Запуск тестирования логики синхронизации...
cd wb-slots
echo Запускаем тест новой логики синхронизации...
node scripts\test-warehouse-sync.js

echo.
echo [3/3] Рекомендации по использованию:
echo.
echo 🔧 НОВАЯ ЛОГИКА СИНХРОНИЗАЦИИ:
echo.
echo ✅ ПРЕИМУЩЕСТВА:
echo    - Добавляет только новые склады
echo    - Обновляет существующие при изменениях
echo    - Сохраняет неизмененные склады
echo    - Предоставляет детальную статистику
echo    - Поддерживает принудительную очистку
echo.
echo 📋 РЕЖИМЫ СИНХРОНИЗАЦИИ:
echo.
echo 1. ОБЫЧНАЯ СИНХРОНИЗАЦИЯ:
echo    - URL: POST /api/warehouses/sync
echo    - Добавляет только новые склады
echo    - Обновляет измененные склады
echo    - Сохраняет существующие без изменений
echo.
echo 2. ПРИНУДИТЕЛЬНАЯ СИНХРОНИЗАЦИЯ:
echo    - URL: POST /api/warehouses/sync?force=true
echo    - Полностью очищает справочник
echo    - Загружает все склады заново
echo    - Используйте только при проблемах
echo.
echo 📊 СТАТИСТИКА ОТВЕТА:
echo    - total: общее количество складов
echo    - newWarehouses: количество новых складов
echo    - updatedWarehouses: количество обновленных
echo    - unchangedWarehouses: количество без изменений
echo    - usedFallback: использованы ли fallback данные
echo    - hasChanges: были ли изменения
echo.
echo 🎯 ИСПОЛЬЗОВАНИЕ В ИНТЕРФЕЙСЕ:
echo.
echo 1. Откройте настройки: http://localhost:3000/settings
echo 2. Перейдите на вкладку "Склады"
echo 3. Нажмите "Обновить из WB API" для обычной синхронизации
echo 4. Нажмите "Принудительно" для полной перезагрузки
echo 5. Проверьте детальную статистику в уведомлении
echo.
echo 🔍 ПРОВЕРКА РЕЗУЛЬТАТОВ:
echo.
echo 1. Проверьте логи сервера для детальной информации
echo 2. Используйте API статистики: GET /api/warehouses/stats
echo 3. Проверьте базу данных на наличие новых складов
echo 4. Убедитесь, что существующие склады не дублируются
echo.
echo ========================================
echo    Тестирование завершено
echo ========================================
pause
